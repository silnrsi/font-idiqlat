  <testgroup label="Running text">
    <test label="para1"  dir="rtl">
      <comment>p1</comment>
      <string dir="rtl">ܣܲܪܒ݂ܲܫܲܟܬܲܢܘܼܡ ܦܝܼܬܵܒ݂ܘܼܡܵܝܲܐ ܐܹܟܲܕܲܝܒ݂ܲܬ̱ܝܼܠ ࡢܲࡠ̱ܲࡨ ܒ݂ܝܼܫܒ݂ܲܣܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para2" dir="rtl">
      <comment>p2</comment>
      <string dir="rtl">ܕܪܫܝܲܒ݂ܘܼܡ ܐܲܕܪܫܝܲܒ݂ܘܼܡܵܝܲܐ ܣܲܟܲܠܲܬ̱ܝܼܢܪ̱ܸܝܘܼܡ ܣܪܲࡪࡣܵܒ݂ܝܼܠ ࡢܲࡠ̱ܲࡨ ܒ݂ܝܼܫܒ݂ܲܣܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para3" dir="rtl">
      <comment>p3</comment>
      <string  dir="rtl">ܕܲܝܒ݂ܲܬ̱ܝܼܢܪ̱ܸܐ ܐܹܟܲܦܘܼܬܪܲܢܘܼܡ ܣܲܟܲܠܲܣܪࡪࡣܝܼܟܲࡨܟ̱ܘܼܡ ܡܘܼܡܦܘܼࡨ̱ܲܐ ܐܵܕܝܲࡡܵܬܲܢܘܼܡ ܝܘܼܓܲࡠ̱ܲࡨܟ̱ܸܠ̱ܵܡ ܡܘܼܡܦܘܼ ܦܝܼܬܵܒ݂ܝܼܠࡥܝܼࡥ̱ܘܼ ࡡܲܢܝܼܫ̱݁ܲܒ݂ܲܢܘܼܡ ܐܸࡥ̱ܵܠ ܣܪࡪࡣ̱ܝܼܟ̱ܲܦ̱ܸࡣܵܬ̱ܲܒ݂ܲܢܘܼܡ ܐܹܟܲܟܲܪܬ̱ܵܒ݂ܘܼܡܵܝܲܐ ܝܼܫܘܿܥ ܡܫܝܼܚܵܝܼܠ ࡢܲࡠ̱ܲࡨ ܒ݂ܝܼܫܒ݂ܲܣܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para4" dir="rtl">
      <comment>p4</comment>
      <string>ܐܲܒ݂ܝܼࡣܲࡥ̱ܘܼ ܣܲܬܝܲܕܲܝܒ݂ܲܬ̱ܝܼܠࡥܝܼࡥ̱ܘܼࡨ̱ܲܐ ܣܲܬܝܲܕܲܝܒ݂ܲܒ݂ܘܼܡ ܦܝܼܬܵܒ݂ܝܼܢܘܿࡣܘܼܟܘܼࡣܸܐ ܐܹܟܲܣܲܬ̱ܲܝܘܼܡܵܟܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para5" dir="rtl">
      <comment>p5</comment>
      <string dir="rtl">ܐܲܒ݂ܝܼࡣܲࡥ̱ܘܼ ܒ݂ܲࡩܝܼ ܦܪܲܦܲࡢܫ݁ܲܡ ܣܲܡܒ݂ܝܼܕ̃ܵܢܲܡ ܫܸ݁ܝ̱ܲܦ̱ܸࡣܘܼܟܲܝܘܼܡ ܐܸܠ̱ܵܡ ܣܪࡪࡣܝܼܟ̱ܲܦ̱ܸࡣܘܼܟܲܝܘܼܡ ܫܸ݁ܝܬܘܼ.</string>
    </test>
    <test label="para6">
      <comment>p6</comment>
      <string>ܡܲܢܘܼࡪܝܲࡧܵܝܲܐ ࡥܲܡܘܼܟ̱ܘܼܒ݂ܹࡤࡣܝܼܝܘܼܡ ࡥܲܡ̱ܘܼࡣܸܐ ࡧܲܟࡪܲܝܟ̱ܘܼܒ݂ܹࡤࡣܝܼܝܘܼܡ ܐܲܒ݂ܝܼࡣܲࡥ̱ܘܼ ܣܒ݂ܲܪܓܲܬ̱ܝܼܠࡥܝܼࡥ̱ܝܼܪܲࡠ̱ܝܼ ܦܲࡧܝܼܫܘܼܕܕ̃ܵܬܡܵܒ݂ܝܼܢܵܠ، ܟܲܢܝܲܟܵܡܲܪܝܲܬ̱ܝܼܠࡥܝܼࡥ̱ ܫܲࡧܝܼࡧܲܡ ܣܒ݂ܝܼܟܲࡧܝܼܫ̱݁ܘܼ ܡܲܢܘܼࡪܝܲܢܵܝܼܦ̱ܝܼܪܲࡥ̱ܘܼ.</string>
    </test>
    <test label="para7">
      <comment>p7</comment>
      <string>ܦܲܢܛܝܼܘܿܣ ܦܝܼܠܵܛܘܿܣܝܼܢܪ̱ܸܐ ܟܵܠܲܬ̱ ܦܝܼܖܲܟܲࡨ ܣܲܗܝܼܟ̱ܘܼܟܲܝܘܼܡ ܨܠܝܼܒܵܝܼܠ ܬܲܪܲܝܟ̱ܲܦ̱ܸࡣ̱ܘܼ ܡܲࡧܝܼܟ̱ܘܼܟܲܝܘܼܡ ܣܲܡܣܟܲࡧܝܼܟ̱ܲܦ̱ܸࡣܘܼܟܲܝܘܼܡ ܐܸࡩܘܼܬܲܦ̱ܸࡣ̱ܝܼࡧܝܼܟ̱ܘܼࡥ̱ܲܬܘܼܦܘܿܠܸܐ ܡܘܼࡥ̱ܵܡܕܝܼܒ݂ܲܣܲܡ ܐܘܼܝܼܪܬ̱ܸࡩܘܼࡥ̱ܹܠܟ̱ܘܼܟܲܝܘܼܡ ܫܸ݁ܝܬܘܼ.</string>
    </test>
    <test label="para8">
      <comment>p8</comment>
      <string>ܐܲܒ݂ܝܼࡣܲࡥ̱ܘܼ ܣܒ݂ܲܪܓܲܬ̱ܝܼܠܹܟ̱‍ ܐܸࡩܘܼࡥ̱ܲࡨ̱ܝܼ ܦܝܼܬܵܒ݂ܝܼܢܪ̱ܸܐ ܒ݂ܲܠܲܬ̱ܘܼࡦܵܓܲܬ̱ܝܼࡧܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para9">
      <comment>p9</comment>
      <string>ܡܲࡧܝܼܫ̱݁ܲܒ݂ܲࡧܸܝܘܼܡ ࡡܝܼܒ݂ܝܼܟ̱ܘܼࡥ̱ܲܒ݂ܲࡧܸܝܘܼܡ ܒ݂ܝܼܕ̃ܝܼܟ̱ܵܢ ܐܲܒ݂ܝܼࡣܲࡥ̱ܘܼ ܒ݂ܝܼࡤࡣܘܼܡ ܒ݂ܲࡧܵܢܝܼࡧܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para10">
      <comment>p10</comment>
      <string>ܦܝܼܬܵܒ݂ܝܼܠࡥܝܼࡥ̱ܘܼܡ ܦܘܼܪܲܦ̱ܸࡣܘܼࡥ̱ܲܐ ܣܲܬܝܵܬܡܵܒ݂ܘܼܡ ࡡܝܼܒ݂ܲܕܵܬܵܒ݂ܘܼܡܵܝܲܐ ܐܹܟܲܦܲࡧܝܼܫܘܼܕܕ̃ܵܬܡܵܒ݂ܝܼܠܘܼܡ ࡢܲࡠ̱ܲࡨ ܒ݂ܝܼܫܒ݂ܲܣܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para11">
      <comment>p11</comment>
      <string>ܐܹܟܲܒ݂ܘܼܡ ܦܲࡧܝܼܫܘܼܕ̃ܲܒ݂ܘܼܡ ܫܠܲܝܚܝܼܟܲܒ݂ܘܼܡ ܣܵܪܒ݂ܲܬܪܝܼܟܲܒ݂ܘܼܡܵܝܲܐ ܣܲࡦܲܝܼܠܘܼܡ ࡢܲࡠ̱ܲࡨ ܒ݂ܝܼܫܒ݂ܲܣܝܼܟ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para12">
      <comment>p12</comment>
      <string>ܦܵܦܲܡܘܿܫ݁ܲܢܲܬ̱ܝܼܢܘܼࡨ̱ܲܐ ܐܹܟܲܐ ܡܲܥܡܘܿܕܝܼܬ݂ܵܝܘܼܡ ܫܲࡧܝܼࡧܲܬ̱ܝܼܢܪ̱ܸܐ ܐܘܼܝܼܪܦ̱ܘܼܡ ࡥܝܼܬܝܵܝܘܼܣ̱ܘܼܡ ࡢܲࡠ̱ܲࡨ ܐܹܪ̱ܘܼܦܲܪܲܝܘܼܟܲܝܘܼܡ ܫܸ݁ܝ̱ܘܼࡥ̱ܘܼ.</string>
    </test>
    <test label="para13">
      <comment>p13</comment>
      <string>ܐܵܡܹܝܢ.</string>
    </test>
  </testgroup>
</ftml>
