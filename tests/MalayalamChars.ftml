  <testgroup label="Kerning ra">
   <comment>This test is to make sure the letters following ra are spaced correctly.</comment>
    <test label="ra all isolate" dir="rtl" stylename="cv18_1_cv55_1">
      <comment></comment>
      <string dir="rtl">\u0867\u0710 \u0867\u0712 \u0867\u0713 \u0867\u0714 \u0867\u0715 \u0867\u0716 \u0867\u0717 \u0867\u0718 \u0867\u0719 \u0867\u0720 \u0867\u0721 \u0867\u0722 \u0867\u0723 \u0867\u0724 \u0867\u0725 \u0867\u0726 \u0867\u0727 \u0867\u0728 \u0867\u0728\u0722 \u0867\u0729 \u0867\u072a \u0867\u072b \u0867\u072c \u0867\u072d \u0867\u072e \u0867\u072f \u0867\u074d \u0867\u074e \u0867\u074f \u0867\u0860 \u0867\u0861 \u0867\u0862 \u0867\u0863  \u0867\u0864 \u0867\u0865 \u0867\u0866 \u0867\u0867 \u0867\u0868 \u0867\u0869 \u0867\u086a</string>
    </test>
